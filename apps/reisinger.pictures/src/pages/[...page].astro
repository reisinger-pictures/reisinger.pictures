---
import type { Page, PaginateFunction } from "astro";
import { type CollectionEntry, getCollection, getEntry } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import HomeIntro from "../components/home/HomeIntro.astro";
import MinimalPage from "../components/pages/MinimalPage.astro";
import PortfolioGrid from "../components/Portfolio.astro";
import type { SchemaCreationFunction } from "../components/SchemaOrg";
import SchemaOrg from "../components/SchemaOrg.astro";
import { createWebPageSchema } from "../components/SchemaOrg.factory";
import SocialImage from "../components/SocialImage.astro";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const allPosts = (await getCollection("portfolio")).sort((a, b) => {
    const aTime = Math.max(a.data.date.valueOf(), a.data.updated?.valueOf() ?? 0);
    const bTime = Math.max(b.data.date.valueOf(), b.data.updated?.valueOf() ?? 0);
    return bTime - aTime;
  });

  return paginate(allPosts, { pageSize: 12 });
}

const { page } = Astro.props;

let indexTitle = "Florian Reisinger Fotografie";

const pageDescription =
  "Fotograf Florian Reisinger aus Linz – authentische Portrait-, Beauty-, Akt-, Boudoir- und Pärchen-Shootings. Professionelle Sportfotografie aus der österreichischen Bundesliga.";

const createData: SchemaCreationFunction = (o, p, _df, url) => createWebPageSchema({
  name: indexTitle,
  description: pageDescription,
  url,
  author: p,
  publisher: o
});

if (page.currentPage === 1) {
  const indexEntry = await getEntry("portfolioOverviews", "index");
  if (indexEntry) {
    indexTitle = indexEntry.data.title || indexTitle;
  }
}

// WebSite schema only on the homepage (page 1) — enables sitelinks search box etc.
const websiteSchema = page.currentPage === 1
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: "Fotograf Florian Reisinger",
      url: Astro.site?.toString(),
      description: pageDescription,
      inLanguage: "de-AT"
    })
  : undefined;
---
<MinimalPage showFloatingContact={page.currentPage !== 1}>
  <BaseHead
    title={page.currentPage === 1 ? indexTitle : `Portfolio & Fotografie Blog – Seite ${page.currentPage} | Florian Reisinger`}
    description={pageDescription}
    slot="head"
  >
    <SocialImage name="beauty-sarah-home2025-portrait-rothaarig-intensiver-blick" />
    <SchemaOrg createData={createData} />
    {websiteSchema && <script type="application/ld+json" is:inline set:html={websiteSchema} />}
  </BaseHead>

  {page.currentPage === 1 && <HomeIntro />}

  <div
    id="portfolio-blog"
    tabindex="-1"
    class="scroll-mt-24 [&:not(:nth-child(3))]:mt-16 [&:not(:nth-child(3))]:pt-10 [&:not(:nth-child(3))]:border-t [&:not(:nth-child(3))]:border-base-200"
  >
    <h2 class="text-3xl font-black mb-8 text-center">Neueste Einblicke aus dem Portfolio</h2>
    <PortfolioGrid page={page as Page<CollectionEntry<"portfolio">>} />
  </div>
</MinimalPage>
