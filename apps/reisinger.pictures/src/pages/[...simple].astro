---
import { absoluteLink } from "@reisinger/shared/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import HeroBanner from "../components/HeroBanner.astro";
import MinimalPage from "../components/pages/MinimalPage.astro";
import Published from "../components/Published.astro";
import type { SchemaCreationFunction } from "../components/SchemaOrg";
import SchemaOrg from "../components/SchemaOrg.astro";
import { createWebPageSchema } from "../components/SchemaOrg.factory";
import SocialImage from "../components/SocialImage.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { loadImage } from "../images/image-service";

export async function getStaticPaths() {
  const posts = await getCollection("simple");
  return posts.filter(post => post.id !== "index").map((post) => ({
    params: { simple: post.id },
    props: post
  }));
}
type Props = CollectionEntry<"simple">;

const post = Astro.props;
const { data } = post;
const { title, description, heroImage, showContact, index = true, ...dates } = data;
const { Content } = await render(post);

const imageInfo = heroImage ? await loadImage(heroImage) : undefined;

const src = imageInfo?.src;

const createData: SchemaCreationFunction = (o, p, df, url) => createWebPageSchema({
  name: title,
  description,
  url,
  author: p,
  publisher: o,
  datePublished: df(dates.date),
  dateModified: df(dates.updated),
  image: src === undefined ? undefined : absoluteLink(Astro.url, src)
});
---

<MinimalPage showContact={showContact}>
  <BaseHead title={title} description={description} noIndex={!index} slot="head">
    <SocialImage name={heroImage} />
    <SchemaOrg createData={createData} />
  </BaseHead>
  {heroImage && <HeroBanner slot="hero" name={heroImage} alt={title} />}
  <div class="content-measure">
    <h1>{title}</h1>
    <Published {...dates} />

    <Content components={{ TableOfContents }} />
  </div>
</MinimalPage>