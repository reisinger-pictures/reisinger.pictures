---
import { absoluteLink } from "@reisinger/shared/utils";
import { type CollectionEntry, getCollection, render } from "astro:content";

import BaseHead from "../components/BaseHead.astro";
import HeroBanner from "../components/HeroBanner.astro";
import EditorialHero from "../components/pages/EditorialHero.astro";
import MinimalPage from "../components/pages/MinimalPage.astro";
import Published from "../components/Published.astro";
import type { SchemaCreationFunction } from "../components/SchemaOrg";
import SchemaOrg from "../components/SchemaOrg.astro";
import { createWebPageSchema } from "../components/SchemaOrg.factory";
import SocialImage from "../components/SocialImage.astro";
import TableOfContents from "../components/TableOfContents.astro";
import { loadImage } from "../images/image-service";

export async function getStaticPaths() {
  const posts = await getCollection("simple");
  return posts.filter(post => post.id !== "index").map((post) => ({
    params: { simple: post.id },
    props: post
  }));
}
type Props = CollectionEntry<"simple">;

const post = Astro.props;
const { data } = post;
const { title, description, heroImage, showContact, index = true, ...dates } = data;
const { Content } = await render(post);

const imageInfo = heroImage ? await loadImage(heroImage) : undefined;

const src = imageInfo?.src;

// Route-specific editorial hero instead of the shared band. Only
// `/personal-branding/` opts in; `HeroBanner` and every other caller of it are
// unchanged (rules/10-ui-review-findings.md, 2026-10-19 round).
const editorialImage = post.id === "personal-branding" ? heroImage : undefined;

// A single long German compound must not split mid-word on narrow screens.
const isDsb = post.id === "dsb";

const createData: SchemaCreationFunction = (o, p, df, url) => createWebPageSchema({
  name: title,
  description,
  url,
  author: p,
  publisher: o,
  datePublished: df(dates.date),
  dateModified: df(dates.updated),
  image: src === undefined ? undefined : absoluteLink(Astro.url, src)
});
---

<MinimalPage showContact={showContact}>
  <BaseHead title={title} description={description} noIndex={!index} slot="head">
    <SocialImage name={heroImage} />
    <SchemaOrg createData={createData} />
  </BaseHead>
  {heroImage && !editorialImage && <HeroBanner slot="hero" name={heroImage} alt={title} />}
  {editorialImage ? (
    <EditorialHero title={title} description={description} imageName={editorialImage} alt={title}>
      <Published {...dates} />
      <Content components={{ TableOfContents }} />
    </EditorialHero>
  ) : (
    <div class="content-measure">
      <h1 class:list={[isDsb && "max-sm:text-[clamp(1.25rem,6.4vw,2.25rem)]"]}>{title}</h1>
      <Published {...dates} />

      <Content components={{ TableOfContents }} />
    </div>
  )}
</MinimalPage>