---
import { groupBy } from "@reisinger/shared/utils";
import { type CollectionEntry, getCollection } from "astro:content";

import PrivateAreaPage from "../../../components/areas/PrivateAreaPage.astro";
import SportAreaPage from "../../../components/areas/SportAreaPage.astro";
import { getPortfolioPrefix, selectRelatedPosts, sortAreasByPriority } from "../../../data/shooting-areas";

// One route, two collections, unchanged URLs: private offers and sport areas
// both render under `/shootings/<area-id>/`. The split (and the two distinct
// compositions) is documented in `rules/09-shooting-areas.md`.

interface AreaProps {
  reviews: CollectionEntry<"testimonials">[];
  relatedPosts: CollectionEntry<"portfolio">[];
  portfolioPrefix: string | null;
}

type Props =
  | ({ kind: "private"; entry: CollectionEntry<"privateAreas">; siblings: CollectionEntry<"privateAreas">[] } & AreaProps)
  | ({ kind: "sport"; entry: CollectionEntry<"sportAreas"> } & AreaProps);

export async function getStaticPaths() {
  const [privateAreas, sportAreas, testimonials, portfolioPosts] = await Promise.all([
    getCollection("privateAreas"),
    getCollection("sportAreas"),
    getCollection("testimonials"),
    getCollection("portfolio")
  ]);

  const reviewsByType = groupBy(testimonials, e => e.data.type);
  const orderedPrivateAreas = sortAreasByPriority(privateAreas);

  return [
    ...orderedPrivateAreas.map(entry => {
      const prefix = getPortfolioPrefix(entry.id);
      return {
        params: { area: entry.id },
        props: {
          kind: "private" as const,
          entry,
          reviews: reviewsByType[entry.id] || [],
          siblings: orderedPrivateAreas.filter(sibling => sibling.id !== entry.id),
          relatedPosts: selectRelatedPosts(portfolioPosts, prefix),
          portfolioPrefix: prefix
        }
      };
    }),
    ...sportAreas.map(entry => {
      const prefix = getPortfolioPrefix(entry.id);
      return {
        params: { area: entry.id },
        props: {
          kind: "sport" as const,
          entry,
          reviews: reviewsByType[entry.id] || [],
          relatedPosts: selectRelatedPosts(portfolioPosts, prefix),
          portfolioPrefix: prefix
        }
      };
    })
  ];
}

const props = Astro.props;
---
{props.kind === "private"
  ? <PrivateAreaPage
      entry={props.entry}
      reviews={props.reviews}
      siblings={props.siblings}
      relatedPosts={props.relatedPosts}
      portfolioPrefix={props.portfolioPrefix}
    />
  : <SportAreaPage
      entry={props.entry}
      reviews={props.reviews}
      relatedPosts={props.relatedPosts}
      portfolioPrefix={props.portfolioPrefix}
    />}
