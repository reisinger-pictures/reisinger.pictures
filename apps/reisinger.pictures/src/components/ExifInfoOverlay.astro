---
interface Props {
  infoId: string;
  title?: string;
  equipment?: string;
  exifCompact?: string;
}

const { infoId, title, equipment, exifCompact } = Astro.props;
---

<div class="info-overlay group absolute inset-0 pointer-events-none">
  <input type="checkbox" id={infoId} class="peer sr-only" />
  <label
    for={infoId}
    class="pointer-events-auto absolute top-3 right-3 z-10 size-9 flex items-center justify-center rounded-full bg-primary/70 text-primary-content ring-1 ring-primary-content/30 opacity-90 hover:opacity-100 peer-checked:opacity-100 peer-focus-visible:opacity-100 cursor-pointer transition-all"
    aria-label="Bildinformationen ein-/ausblenden"
  >
    <span class="icon-[mdi--information-outline] size-5" />
  </label>
  <div class="info-box pointer-events-none absolute inset-x-0 bottom-0 bg-base-300/90 backdrop-blur p-4 text-sm opacity-0 peer-checked:opacity-100 peer-checked:pointer-events-auto transition-opacity">
    {title && <p class="text-base-content leading-snug m-0">{title}</p>}
    {equipment && <p class="text-base-content/80 m-0 mt-1">{equipment}</p>}
    {exifCompact && <p class="text-base-content/70 m-0 mt-0.5">{exifCompact}</p>}
  </div>
</div>
