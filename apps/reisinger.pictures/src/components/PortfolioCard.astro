---
import type { NumericBreakpoints } from "@reisinger/shared/utils/Breakpoints";
import { type CollectionEntry } from "astro:content";

import ContentCard from "./ContentCard.astro";

interface Props {
  post: CollectionEntry<"portfolio">;
  imageSizeModifiers?: Partial<NumericBreakpoints>;
  class?: string;
  /** Show the post's publication date on the card (off by default). */
  showDate?: boolean;
}

const { post, imageSizeModifiers, class: clazz, showDate = false } = Astro.props;
---
<ContentCard
  href={`/portfolio/${post.id}/`}
  imageName={post.data.heroImage}
  title={post.data.title}
  overlay={false}
  imageSizeModifiers={imageSizeModifiers}
  class={clazz}
  date={post.data.date}
  showDate={showDate}
/>
