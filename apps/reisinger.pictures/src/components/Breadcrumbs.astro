---
import { type DataCollectionKey, getCollection, getEntry } from "astro:content";

import { buildBreadcrumbs, extractTestimonialId } from "./Breadcrumbs.config";

const astroUrl = Astro.url;
const { pathname } = astroUrl;
const url = pathname.replace(/\/$/, "");

function titleOrUndefined(o: Record<string, unknown>): string | undefined {
  if (typeof o.title === "string") {
    return o.title;
  }
  if (typeof o.name === "string") {
    return o.name;
  }
  return undefined;
}

function toName(input: string): string {
  const parts = input.split("/");
  const last = parts[parts.length - 1];
  const formatted = last.replace(/[-_]/g, " ");
  return formatted.charAt(0).toUpperCase() + formatted.slice(1);
}

const contentPrefixConfig: Record<DataCollectionKey, string> = {
  agb: "agb",
  categories: "gallery",
  courses: "kurse",
  dsb: "dsb",
  portfolio: "portfolio",
  portfolioOverviews: "portfolio",
  privateAreas: "shootings",
  simple: "",
  sportAreas: "shootings",
  testimonialSummary: "_testimonial",
  testimonials: "testimonials",
  tfp: "tfp"
};

const collectionKeys = Object.entries(contentPrefixConfig)
  .filter(([, v]) => v === "" || url.startsWith(`/${v}`))
  .map(([k]) => k as DataCollectionKey);


const matchingContent = (await Promise.all(
    collectionKeys
      .flatMap(async k => (await getCollection(k))
        .map(e => {
            const cur = e as { id: string, data: Record<string, unknown> };
            let path = contentPrefixConfig[k];
            if (path.length > 0)
              path = `/${path}`;
            const slug = cur.id;
            if (slug !== "/")
              path += `/${slug}`;

            return {
              path,
              name: titleOrUndefined(cur.data) ?? toName(slug)
            };
          }
        )
      )
  )
);

const urlAncestors = matchingContent.flatMap(k => k)
  .filter(({ path }) => path !== "" && path !== url && url.startsWith(`${path}/`))
  .sort(({ path: a }, { path: b }) => a.length - b.length);

const testimonialId = extractTestimonialId(url);
const detailType = testimonialId !== undefined
  ? (await getEntry("testimonials", testimonialId))?.data.type
  : undefined;

const matchingUrls = buildBreadcrumbs(url, urlAncestors, detailType);
---

{url !== "" &&
<div class="breadcrumbs [scrollbar-gutter:stable] not-prose">
  <ul>
    <li><a aria-label="Startseite" href="/"><span class="icon-[mdi--home]" /> Startseite</a></li>
    {matchingUrls.map(({ name, path }) => (
      <li>
        <a href={path}>{name}</a>
      </li>
    ))}
  </ul>
</div>}

{url !== "" &&
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Startseite",
      item: new URL("/", astroUrl).href
    },
    ...matchingUrls.map(({ name, path }, index) => ({
      "@type": "ListItem",
      position: index + 2,
      name,
      item: new URL(path + "/", astroUrl).href
    }))
  ]
})} />
}
