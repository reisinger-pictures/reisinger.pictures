---
import { type CollectionEntry, render } from "astro:content";

import { testimonialTypes } from "../data/testimonialTypes";
import { tryGetImage } from "../images/slug-map";
import ResponsiveImage from "./ResponsiveImage.astro";
import ReviewAvatar from "./ReviewAvatar.astro";
import ReviewSocialLink from "./ReviewSocialLink.astro";
import { type ReviewProps } from "./Types";

type Props = CollectionEntry<"testimonials"> & ReviewProps;

const entry = Astro.props;
const {
  id: slug,
  data: { name, type, source, role, layout: frontmatterLayout, large: optLargeImage, small: optSmallImage, imageFit },
  displayLargeImage = true,
  layout = frontmatterLayout,
  showDetailLink = false,
  showCategory = false
} = entry;
const smallName = optSmallImage ?? `${slug}-small`;
const largeName = optLargeImage ?? `${slug}-large`;
const small = tryGetImage(smallName);
const large = tryGetImage(largeName);
const { Content } = await render(entry);
const categoryName = type !== undefined ? (testimonialTypes[type]?.title ?? type) : undefined;
const categoryHref = type !== undefined ? `/shootings/${type}/testimonials` : undefined;
---

<div data-slug={import.meta.env.DEV ? slug : undefined} class="relative">
  {/* One shared card for every review: the same surface, the same centred
      identity slot (avatar + name + role) and the same footer. Only the body
      differs — a customer portrait shows its photo and plain text, a company
      quote shows its logo and italic quote text. */}
  <div class="card bg-base-200 border border-base-300 shadow-sm h-full">
    <div class="card-body items-center text-center pb-4">
      {small !== undefined &&
        <ReviewAvatar name={smallName} imageFit={imageFit} containerClass="size-32 shadow-sm" paddingClass="p-4" sizes="128px" widths={[128]} />
      }
      <div>
        <h4 class="card-title">{name}</h4>
        {role && <p class="text-sm opacity-70 m-0!">{role}</p>}
      </div>
    </div>

    {layout !== "quote" && displayLargeImage && large !== undefined &&
      <figure>
        <ResponsiveImage name={largeName} showInfo={true} />
      </figure>
    }

    <div class="card-body pt-4">
      {layout === "quote"
        ? <blockquote class="prose prose-lg italic m-0!"><Content /></blockquote>
        : <Content />}
    </div>

    {showDetailLink &&
      <div class="mt-auto flex items-center border-t border-base-content/10">
        <a href={`/testimonials/${slug}`} aria-label={`Bewertung von ${name} lesen`} class:list={["flex items-center gap-2 px-4 sm:px-6 py-3 no-underline text-inherit hover:bg-base-content/5 hover:text-primary transition-colors", showCategory ? "w-1/4 shrink-0 min-w-fit" : "grow"]}>
          <span class="icon-[mdi--information-outline] text-lg" aria-hidden="true" />
          <span class="text-sm font-medium whitespace-nowrap">Details</span>
        </a>
        {showCategory && categoryName !== undefined && categoryHref !== undefined &&
          <a href={categoryHref} class="group flex grow items-center justify-end gap-1.5 px-6 py-3 border-l border-base-content/10 no-underline text-inherit hover:bg-base-content/5 hover:text-primary transition-colors">
            <span class="text-sm font-medium">{categoryName}</span>
            <span class="text-primary icon-[mdi--arrow-right] text-xl group-hover:translate-x-1 transition-transform" aria-hidden="true" />
          </a>
        }
      </div>
    }
  </div>
  {source !== undefined && <ReviewSocialLink source={source} class="absolute right-4 top-4 z-10" />}
</div>
