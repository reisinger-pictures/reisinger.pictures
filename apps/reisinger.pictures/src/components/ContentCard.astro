---
import type { NumericBreakpoints } from "@reisinger/shared/utils/Breakpoints";

import FormattedDate from "./FormattedDate.astro";
import { GALLERY_BREAKPOINTS, GalleryLayout } from "./GalleryLayout";
import ResponsiveImage from "./ResponsiveImage.astro";

export interface Props {
  href: string;
  imageName: string;
  title: string;
  /** Use the image sidecar description instead of the card title as alt text. */
  imageDescriptionAlt?: boolean;
  overlay: boolean;
  imageSizeModifiers?: Partial<NumericBreakpoints>;
  class?: string;
  titleClass?: string;
  aspectRatio?: string;
  fit?: "contain" | "cover";
  /** Publication date; only rendered when `showDate` is true. */
  date?: Date;
  /** Defaults off so every other card renders unchanged. */
  showDate?: boolean;
}

const {
  href,
  imageName,
  title,
  imageDescriptionAlt = false,
  overlay,
  imageSizeModifiers = GALLERY_BREAKPOINTS[GalleryLayout.Overview],
  class: className,
  titleClass = "text-lg",
  aspectRatio = "3/2",
  // `cover` keeps the uniform card grid: `contain` left grey bars on the sides of
  // portrait photos inside the 3/2 frame (see rules/10-ui-review-findings.md §2).
  fit = "cover",
  date,
  showDate = false
} = Astro.props;
---

{overlay ? (
  <a
    href={href}
    class:list={[
      "card bg-base-300 shadow-md overflow-hidden no-underline rounded-none block w-full group flex flex-col",
      className
    ]}
  >
    <figure
      class="relative w-full flex-1 max-h-128 overflow-hidden bg-base-300"
      style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
    >
      <ResponsiveImage
        class="w-full h-full transition-transform duration-300 group-hover:scale-105"
        sizeModifiers={imageSizeModifiers}
        alt={imageDescriptionAlt ? undefined : title}
        name={imageName}
        showInfo={true}
        fit={fit}
      />

      <div class="absolute bottom-0 inset-x-0 z-10 bg-base-100/90 backdrop-blur-sm px-4 py-3">
        <h3 class:list={["card-title text-base-content !m-0 group-hover:text-primary transition-colors", titleClass]}>{title}</h3>
        {showDate && date && (
          <p class="m-0 text-sm text-base-content/70"><FormattedDate date={date} /></p>
        )}
      </div>
    </figure>
  </a>
) : (
  <a
    href={href}
    class:list={[
      "card bg-base-300 shadow-md overflow-hidden no-underline rounded-none block w-full group flex flex-col",
      className
    ]}
  >
    <figure
      class="w-full max-h-128 overflow-hidden bg-base-300"
      style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
    >
      <ResponsiveImage
        class="w-full h-full transition-transform duration-300 group-hover:scale-105"
        sizeModifiers={imageSizeModifiers}
        alt={title}
        name={imageName}
        showInfo={true}
        fit={fit}
      />
    </figure>

    <div class="bg-base-100/90 backdrop-blur-sm px-4 pt-3 pb-4 flex-1 flex flex-col items-center justify-center gap-1">
      <h3 class="card-title text-base-content text-lg !m-0 group-hover:text-primary transition-colors">{title}</h3>
      {showDate && date && (
        <p class="m-0 text-sm text-base-content/70"><FormattedDate date={date} /></p>
      )}
    </div>
  </a>
)}
