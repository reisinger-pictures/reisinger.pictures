---
import type { NumericBreakpoints } from "@reisinger/shared/utils/Breakpoints";

import { GALLERY_BREAKPOINTS, GalleryLayout } from "./GalleryLayout";
import ResponsiveImage from "./ResponsiveImage.astro";

export interface Props {
  href: string;
  imageName: string;
  title: string;
  overlay: boolean;
  imageSizeModifiers?: Partial<NumericBreakpoints>;
  class?: string;
  aspectRatio?: string;
  fit?: "contain" | "cover";
}

const {
  href,
  imageName,
  title,
  overlay,
  imageSizeModifiers = GALLERY_BREAKPOINTS[GalleryLayout.Overview],
  class: className,
  aspectRatio = "3/2",
  // `cover` keeps the uniform card grid: `contain` left grey bars on the sides of
  // portrait photos inside the 3/2 frame (see rules/10-ui-review-findings.md §2).
  fit = "cover"
} = Astro.props;
---

{overlay ? (
  <a
    href={href}
    class:list={[
      "card bg-base-300 shadow-md overflow-hidden no-underline rounded-none block w-full group flex flex-col",
      className
    ]}
  >
    <figure
      class="relative w-full flex-1 max-h-128 overflow-hidden bg-base-300"
      style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
    >
      <ResponsiveImage
        class="w-full h-full transition-transform duration-300 group-hover:scale-105"
        sizeModifiers={imageSizeModifiers}
        alt={title}
        name={imageName}
        showInfo={true}
        fit={fit}
      />

      <div class="absolute bottom-0 inset-x-0 z-10 bg-base-100/90 backdrop-blur-sm px-4 py-3">
        <h3 class="card-title text-base-content text-lg !m-0 group-hover:text-primary transition-colors">{title}</h3>
      </div>
    </figure>
  </a>
) : (
  <a
    href={href}
    class:list={[
      "card bg-base-300 shadow-md overflow-hidden no-underline rounded-none block w-full group flex flex-col",
      className
    ]}
  >
    <figure
      class="w-full max-h-128 overflow-hidden bg-base-300"
      style={aspectRatio ? `aspect-ratio: ${aspectRatio};` : undefined}
    >
      <ResponsiveImage
        class="w-full h-full transition-transform duration-300 group-hover:scale-105"
        sizeModifiers={imageSizeModifiers}
        alt={title}
        name={imageName}
        showInfo={true}
        fit={fit}
      />
    </figure>

    <div class="bg-base-100/90 backdrop-blur-sm px-4 pt-3 pb-4 flex-1 flex items-center justify-center">
      <h3 class="card-title text-base-content text-lg !m-0 group-hover:text-primary transition-colors">{title}</h3>
    </div>
  </a>
)}
