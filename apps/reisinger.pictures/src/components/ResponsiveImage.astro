---
import type { NumericBreakpoints } from "@reisinger/shared/utils/Breakpoints";
import { computeSizes, DEFAULT_IMAGE_SIZES, mergeBreakpoints } from "@reisinger/shared/utils/Breakpoints";
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

import { getImage as getSourceImage } from "../images/slug-map";
import type { ImageWithExifMeta } from "../types/image-metadata";
import ExifInfoOverlay from "./ExifInfoOverlay.astro";
import { GALLERY_BREAKPOINTS, GalleryLayout } from "./GalleryLayout";
import { formatEquipment, formatExifCompact, getMetadataForImageSlug } from "./image.utils";
import { ResponsiveImageLoading } from "./ResponsiveImageLoading";

interface ImageWithMeta extends ImageMetadata, Partial<ImageWithExifMeta> {}

interface Props {
  name?: string,
  image?: ImageWithMeta | ImageMetadata,
  alt?: string,
  class?: string,
  height?: string,
  sizes?: string,
  widths?: number[],
  loading?: ResponsiveImageLoading,
  sizeModifiers?: Partial<NumericBreakpoints>,
  showInfo?: boolean,
  fit?: "contain" | "cover"
}

const {
  name,
  sizes,
  sizeModifiers,
  widths: widthsOverride,
  alt,
  loading = ResponsiveImageLoading.LAZY,
  class: classNames,
  showInfo = false,
  image: directImage,
  fit = "contain"
} = Astro.props;

const isDev = import.meta.env.MODE === "development";
const isBuild = import.meta.env.PROD;

const imageWithMeta = directImage as ImageWithMeta | undefined;

// Resolve image metadata instance (dev mode + direct-import fallback)
let image: ImageMetadata | undefined;
if (!isBuild || directImage) {
  if (directImage) {
    image = directImage;
  } else if (name) {
    const resolved = await getSourceImage(name);
    image = resolved.default;
  }
}

// Resolve native dimensions and CDN manifest data
let nativeWidth = 0;
let nativeHeight = 0;
let buildVariants: { width: number, file: string }[] | undefined;

if (isBuild && name) {
  const { getManifestImage } = await import("../images/image-manifest");
  const mi = getManifestImage(name);
  if (mi) {
    nativeWidth = mi.width;
    nativeHeight = mi.height;
    buildVariants = mi.variants
      .filter(variant => variant.format === "webp")
      .sort((left, right) => left.width - right.width)
      .map(variant => ({ width: variant.width, file: variant.file }));
    if (buildVariants.length === 0) buildVariants = undefined;
  } else {
    throw new Error(
      `ResponsiveImage: "${name}" nicht in .astro-image-cdn/manifest.json gefunden. ` +
        `existiert der Slug in src/images/ oder src/content/?`
    );
  }
} else if (image) {
  nativeWidth = image.width;
  nativeHeight = image.height;
}

// --- Common metadata / EXIF ---
const data = imageWithMeta?.description
  ? { description: imageWithMeta.description, darkInvert: imageWithMeta.darkInvert ?? false, metadata: imageWithMeta.metadata ?? null }
  : name ? await getMetadataForImageSlug(name) : undefined;

const darkInvert = data?.darkInvert ?? false;
const resolvedAlt = alt ?? data?.description ?? "";
const computedSizes = sizes ?? computeSizes(mergeBreakpoints(GALLERY_BREAKPOINTS[GalleryLayout.Full], sizeModifiers));
// CDN variants only exist at configured widths; match its next-larger-or-last fallback.
const availableWidths = DEFAULT_IMAGE_SIZES.filter(s => s <= nativeWidth);
const requestedWidths = (widthsOverride ?? DEFAULT_IMAGE_SIZES).filter(s => s <= nativeWidth);
const widths: number[] = Array.from(new Set(requestedWidths.map(requestedWidth =>
  availableWidths.find(availableWidth => availableWidth >= requestedWidth)
    ?? availableWidths[availableWidths.length - 1]
    ?? requestedWidth
)));

const maxOptimizedWidth = widths[widths.length - 1] ?? nativeWidth;
const maxOptimizedHeight = maxOptimizedWidth * nativeHeight / nativeWidth;

const metadata = data?.metadata;
const equipment = formatEquipment(metadata);
const exifCompact = formatExifCompact(metadata);

const infoId = name ? `img-info-${name.replaceAll("/", "-")}` : imageWithMeta?.slug ? `img-info-${imageWithMeta.slug}` : undefined;

const captureDate = metadata?.captureDate ? new Date(metadata.captureDate).toISOString() : undefined;
const aspectRatioValue = `${nativeWidth}/${nativeHeight}`;

// --- Build src / srcset ---
let src: string;
let srcset: string;

if (isBuild && name && buildVariants) {
  const { IMAGE_BASE_URL: cdnBase } = await import("../images/image-config");
  const cdnVariants = buildVariants.filter(variant => widths.includes(variant.width));
  const effectiveVariants = cdnVariants.length > 0 ? cdnVariants : [buildVariants[0]];
  src = `${cdnBase}/${effectiveVariants[effectiveVariants.length - 1].file}`;
  srcset = effectiveVariants.map(variant => `${cdnBase}/${variant.file} ${variant.width}w`).join(", ");
} else if (isBuild && name && !buildVariants) {
  throw new Error(`ResponsiveImage: "${name}" hat keine WebP-Varianten in .astro-image-cdn/manifest.json. Existiert der Slug in src/images/ oder src/content/portfolio/?`);
} else {
  if (!image) {
    throw new Error("ResponsiveImage: Kein Bild verfügbar. image-prop oder name muss gesetzt sein.");
  }
  const imageVariants = await Promise.all(
    widths.map(w => getImage({ src: image, format: "webp", width: w, quality: 75 }))
  );
  src = imageVariants[imageVariants.length - 1].src;
  srcset = imageVariants.map((v, i) => `${v.src} ${widths[i]}w`).join(", ");
}

const darkClass = darkInvert ? "dark:invert" : "";
const fitClass = fit === "cover" ? "object-cover" : "object-contain";
const imgClass = [classNames, darkClass, fitClass].filter(Boolean).join(" ") || undefined;

const commonImgAttrs: Record<string, unknown> = {
  src,
  srcset,
  sizes: computedSizes,
  loading,
  alt: resolvedAlt,
  "data-pswp-width": maxOptimizedWidth,
  "data-pswp-height": maxOptimizedHeight,
  "data-name": isDev ? (name ?? imageWithMeta?.slug) : undefined,
  "data-exif-camera": metadata?.camera,
  "data-exif-lens": metadata?.lens,
  "data-exif-focal": metadata?.focalLength,
  "data-exif-aperture": metadata?.aperture,
  "data-exif-shutter": metadata?.shutter,
  "data-exif-iso": metadata?.iso,
  "data-exif-date": captureDate,
  decoding: "async",
  width: maxOptimizedWidth,
  height: maxOptimizedHeight,
};
---

{showInfo && infoId ? (
  fit === "cover" ? (
    <div class="relative w-full h-full overflow-hidden">
      <img
        {...commonImgAttrs}
        class={[imgClass, "w-full h-full block"].filter(Boolean).join(" ")}
      />
      <ExifInfoOverlay infoId={infoId} title={resolvedAlt} equipment={equipment} exifCompact={exifCompact} />
    </div>
  ) : (
    <div class="relative mx-auto overflow-hidden max-w-full max-h-full" style={`aspect-ratio: ${aspectRatioValue};`}>
      <img
        {...commonImgAttrs}
        class={[imgClass, "w-full h-full object-contain block"].filter(Boolean).join(" ")}
      />
      <ExifInfoOverlay infoId={infoId} title={resolvedAlt} equipment={equipment} exifCompact={exifCompact} />
    </div>
  )
) : (
  <img {...commonImgAttrs} class={imgClass} />
)}
