---
import { computeSizes } from "@reisinger/shared/utils/Breakpoints";

import ResponsiveImage from "../ResponsiveImage.astro";
import { ResponsiveImageLoading } from "../ResponsiveImageLoading";

interface Props {
  title: string;
  imageName?: string;
  description?: string;
  eyebrow?: string;
  /**
   * `sport` renders the photo-dominant sport hero: eyebrow/H1 above, the
   * photograph at full content width with `object-cover` inside a capped
   * aspect box, lead beneath. The default keeps the private editorial
   * two-column split untouched (rules/11-sport-area-redesign-proposal.md §4.1).
   */
  variant?: "default" | "sport";
  class?: string;
}

const { title, imageName, description, eyebrow, variant = "default", class: className } = Astro.props;

// Full content width mirrors the shared `.container` caps. Keep the actual
// mobile gutter (rather than computeSizes' full-viewport default) for widths
// below the container's first breakpoint.
const sportHeroSizes = computeSizes({ sm: 1, md: 1, lg: 1, xl: 1, "2xl": 1 })
  .replace("100vw", "calc(100vw - 2rem)");
---

<header class:list={["not-prose", className]}>
  {variant === "sport" ? (
    /*
      Sport hero: one editorial column, heading first, the photograph at full
      content width (no `bg-base-200` band, no `object-contain` letterbox), the
      existing lead below. Mobile order is heading → photograph → lead.
    */
    <div>
      {eyebrow && (
        <p class="m-0 mb-3 text-xs font-medium uppercase tracking-[0.16em] text-base-content/75">{eyebrow}</p>
      )}
      <h1 class="m-0 text-left! text-3xl font-semibold leading-tight tracking-tight md:text-4xl xl:text-5xl">
        {title}
      </h1>

      {imageName && (
        <figure class="m-0 mt-6 w-full aspect-[3/2] max-h-[80vh]">
          {/*
            `fit="cover"` fills the capped box instead of letterboxing it.
            `showInfo` renders ExifInfoOverlay inside ResponsiveImage's own
            wrapper, which *is* the rendered image box for `object-cover`, so
            the badge cannot detach from the picture
            (rules/10-ui-review-findings.md §9).
          */}
          <ResponsiveImage
            name={imageName}
            loading={ResponsiveImageLoading.EAGER}
            sizes={sportHeroSizes}
            fit="cover"
            showInfo={true}
          />
        </figure>
      )}

      {description && (
        <p class="m-0 mt-6 max-w-prose text-base leading-relaxed text-base-content/85">{description}</p>
      )}
    </div>
  ) : (
    /*
      Mobile order is deliberately heading → photograph → lead text, so the
      photograph appears early. Desktop shares one editorial grid: heading and
      lead on the left, photograph spanning both rows on the right.
    */
    <div class="grid gap-x-12 gap-y-6 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-5">
        {eyebrow && (
          <p class="m-0 mb-3 text-xs font-medium uppercase tracking-[0.16em] text-base-content/75">{eyebrow}</p>
        )}
        <h1 class="m-0 text-left! text-3xl font-semibold leading-tight tracking-tight md:text-4xl xl:text-5xl">
          {title}
        </h1>
      </div>

      {imageName && (
        <figure class="m-0 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1">
          <ResponsiveImage
            name={imageName}
            alt={title}
            loading={ResponsiveImageLoading.EAGER}
            sizes="(min-width: 1024px) 58vw, 100vw"
          />
        </figure>
      )}

      {description && (
        <p class="m-0 max-w-prose text-base leading-relaxed text-base-content/85 lg:col-span-5 lg:row-start-2 lg:self-start">
          {description}
        </p>
      )}
    </div>
  )}
</header>
