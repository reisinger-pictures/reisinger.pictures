---
interface OfferLink {
  href: string;
  label: string;
}

interface Props {
  /** The area id, used to resolve the existing testimonial page. */
  slug: string;
  /** The other private offers, already ordered and labelled by the composition. */
  siblings: OfferLink[];
  class?: string;
}

const { slug, siblings, class: className } = Astro.props;

// Area-specific guide pages that already exist. Only the Akt area has one:
// until now its guide was reachable only through the inline word "hier" in the
// body copy, which made it practically undiscoverable. Owner decision
// 2026-10-19, rules/09-shooting-areas.md.
const guideLinks: Record<string, OfferLink & { note: string }> = {
  akt: {
    href: "/akt/ablauf/",
    label: "Ablauf-Leitfaden",
    note: "Der ganze Ablauf Schritt für Schritt."
  }
};

const links = [
  {
    href: "/preise/",
    label: "Preise & Tarife",
    note: "Alle Tarife und der Preisrechner."
  },
  ...(guideLinks[slug] ? [guideLinks[slug]] : []),
  {
    href: `/shootings/${slug}/testimonials`,
    label: "Kundenbewertungen",
    note: "Erfahrungen anderer Kunden lesen."
  }
];
---

{/*
  Repeating element of the private offer pages: the quiet route from the
  photograph to the existing pricing page, the existing guide page of the area
  (Akt only) and the existing customer reviews.
  No prices, deliverables or usage rights are invented here — every target is
  a pre-existing page.
*/}
<aside class:list={["not-prose", className]} aria-labelledby="weg-zum-shooting">
  <div class="border-t border-base-300 pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
    <h2 id="weg-zum-shooting" class="m-0 text-left! text-xl font-semibold">Dein Weg zum Shooting</h2>

    <ul class="m-0 mt-5 flex list-none flex-col gap-5 p-0">
      {links.map(({ href, label, note }) => (
        <li class="m-0">
          <a
            href={href}
            class="group inline-flex min-h-11 items-center gap-1 font-medium underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {label}
            <span
              class="icon-[mdi--arrow-right] transition-transform duration-200 motion-reduce:transition-none group-hover:translate-x-0.5 motion-reduce:group-hover:translate-x-0"
              aria-hidden="true"></span>
          </a>
          <p class="m-0 mt-1 text-sm text-base-content/75">{note}</p>
        </li>
      ))}
    </ul>

    {siblings.length > 0 && (
      <nav aria-label="Weitere private Shootings" class="mt-6 border-t border-base-300 pt-4">
        <p class="m-0 mb-1 text-xs font-medium uppercase tracking-[0.16em] text-base-content/75">
          Weitere private Shootings
        </p>
        <ul class="m-0 flex list-none flex-col p-0">
          {siblings.map(({ href, label }) => (
            <li class="m-0">
              <a
                href={href}
                class="inline-flex min-h-11 items-center text-sm underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</aside>
