---
import ContactCTA from "@reisinger/shared/components/ContactCTA.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

import { SPORT_ART_HUBS, sportCollectionIds } from "../../data/sport-areas";
import { loadImage } from "../../images/image-service";
import BaseHead from "../BaseHead.astro";
import FeaturedTestimonials from "../FeaturedTestimonials.astro";
import Gallery from "../Gallery.astro";
import { GalleryLayout } from "../GalleryLayout";
import MinimalPage from "../pages/MinimalPage.astro";
import { type SchemaCreationFunction } from "../SchemaOrg";
import SchemaOrg from "../SchemaOrg.astro";
import { createCollectionPageSchema, createWebPageSchema } from "../SchemaOrg.factory";
import SocialImage from "../SocialImage.astro";
import AreaHero from "./AreaHero.astro";
import AreaRelatedPosts from "./AreaRelatedPosts.astro";
import AreaSection from "./AreaSection.astro";

interface Props {
  entry: CollectionEntry<"sportAreas">;
  reviews: CollectionEntry<"testimonials">[];
  relatedPosts: CollectionEntry<"portfolio">[];
  portfolioPrefix: string | null;
  heading: string;
  showDate: boolean;
}

// Sport composition. The hero is the photo-dominant `AreaHero` variant
// (rules/11-sport-area-redesign-proposal.md §4.1), which also owns the single
// H1 of the page; closing sections follow the released sport-area proposal.

const { entry, reviews: categoryReviews, relatedPosts, portfolioPrefix, heading, showDate } = Astro.props;
const { id: slug, data: { name, description, testimonials, images, heroImage } } = entry;
const reviewSlugs: string[] | undefined = testimonials?.map(e => e.id);
const { Content } = await render(entry);
const showPressLinks = slug === "sport" || [
  "sport/american-football",
  "sport/basketball",
  "sport/eishockey",
  "sport/fussball",
  "sport/volleyball"
].includes(slug);

const imageInfo = heroImage ? await loadImage(heroImage) : undefined;

const sportEntries = slug === "sport" || SPORT_ART_HUBS.includes(slug as (typeof SPORT_ART_HUBS)[number])
  ? await getCollection("sportAreas")
  : [];
const entriesById = new Map(sportEntries.map((area) => [area.id, area]));
const collectionIds = sportCollectionIds(sportEntries, slug);

const collectionPageSchema = collectionIds.length > 0
  ? createCollectionPageSchema({
    name,
    description,
    items: collectionIds.flatMap((id) => {
      const area = entriesById.get(id);
      if (!area) return [];
      return [{
        url: new URL(`/shootings/${id}/`, Astro.url).toString(),
        name: area.data.name,
        type: SPORT_ART_HUBS.includes(id as (typeof SPORT_ART_HUBS)[number]) ? "CollectionPage" as const : "WebPage" as const
      }];
    })
  })
  : undefined;

const collectionPageJson = collectionPageSchema ? JSON.stringify(collectionPageSchema) : undefined;
const createData: SchemaCreationFunction = (o, me, _, url) => {
  return createWebPageSchema({ url, name, description, image: imageInfo?.src, author: me, publisher: o });
};
---
<MinimalPage>
  <BaseHead title={name} description={description} slot="head">
    <SocialImage name={heroImage} />
    <SchemaOrg createData={createData} />
    {collectionPageJson && <script type="application/ld+json" is:inline set:html={collectionPageJson} />}
  </BaseHead>

  <AreaHero title={name} imageName={heroImage} description={description} variant="sport" />

  <Content />

  <AreaRelatedPosts posts={relatedPosts} portfolioPrefix={portfolioPrefix} heading={heading} showDate={showDate} />

  {showPressLinks && (
    <AreaSection id="sport-presse" eyebrow="Für Redaktionen" heading="Presse & Redaktionen" class="mt-16">
      <div class="grid gap-6 md:grid-cols-2">
        <div>
          <p class="m-0">Während des Events stehen Bilder im Presse-Portal bereit. Die Dateien enthalten IPTC-Metadaten und können gesammelt als Batch heruntergeladen werden.</p>
        </div>
        <nav aria-label="Informationen für Presse und Redaktionen" class="flex flex-col items-start gap-3">
          <a class="link link-primary inline-flex min-h-11 items-center focus-visible:outline-2 focus-visible:outline-offset-4" href="/portal/">Foto-Portal</a>
          <a class="link link-primary inline-flex min-h-11 items-center focus-visible:outline-2 focus-visible:outline-offset-4" href="/eventfotografie/">Eventfotografie</a>
        </nav>
      </div>
    </AreaSection>
  )}

  {images.length > 0 && (
    <AreaSection id="galerie" eyebrow="Bilder" heading="Galerie" class="mt-16">
      <Gallery sorted={images} layout={GalleryLayout.Sport} />
    </AreaSection>
  )}

  {slug === "sport" && (
    <AreaSection id="kundenstimmen" eyebrow="Erfahrungen" heading="Kundenstimmen" class="mt-16">
      <FeaturedTestimonials slug={slug} categoryTestimonials={categoryReviews} featuredTestimonials={reviewSlugs} />
    </AreaSection>
  )}

  <AreaSection id="sport-kontakt" eyebrow="Sportfotografie" heading="Kontakt" class="mt-16">
    <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_auto] md:items-center">
      <p class="m-0">Vereine, Ligen, Veranstalter und Redaktionen können eine Fotoanfrage stellen.</p>
      <ContactCTA text="Fotoanfrage für Verein oder Redaktion" subjectPrefix="SPORT" class="btn-block h-auto min-h-12 whitespace-normal py-3 leading-tight md:btn-wide" />
    </div>
  </AreaSection>
</MinimalPage>
