---
import { type CollectionEntry, render } from "astro:content";

import { mainLinks, type NavGroup } from "../../data/Menue";
import { loadImage } from "../../images/image-service";
import BaseHead from "../BaseHead.astro";
import FeaturedTestimonials from "../FeaturedTestimonials.astro";
import Gallery from "../Gallery.astro";
import MinimalPage from "../pages/MinimalPage.astro";
import { type SchemaCreationFunction } from "../SchemaOrg";
import SchemaOrg from "../SchemaOrg.astro";
import { createWebPageSchema } from "../SchemaOrg.factory";
import SocialImage from "../SocialImage.astro";
import AreaHero from "./AreaHero.astro";
import AreaOfferRoute from "./AreaOfferRoute.astro";
import AreaRelatedPosts from "./AreaRelatedPosts.astro";
import AreaSection from "./AreaSection.astro";

interface Props {
  entry: CollectionEntry<"privateAreas">;
  reviews: CollectionEntry<"testimonials">[];
  /** The other private offers, ordered by priority. */
  siblings: CollectionEntry<"privateAreas">[];
  relatedPosts: CollectionEntry<"portfolio">[];
  portfolioPrefix: string | null;
}

// Private offer composition (Akt, Beauty, Pärchen): photography-led editorial
// layout. All content (name, description, hero, gallery, testimonials, body)
// comes unchanged from the collection; only the composition is new.
// See rules/09-shooting-areas.md.

const { entry, reviews: categoryReviews, siblings, relatedPosts, portfolioPrefix } = Astro.props;
const { id: slug, data: { name, description, testimonials, images, heroImage } } = entry;
const reviewSlugs: string[] | undefined = testimonials?.map(e => e.id);
const { Content } = await render(entry);

const imageInfo = heroImage ? await loadImage(heroImage) : undefined;

const createData: SchemaCreationFunction = (o, me, _, url) => createWebPageSchema({
  url,
  name,
  description,
  image: imageInfo?.src,
  author: me,
  publisher: o
});

// Short navigation labels reused from the main menu instead of inventing new
// wording from the long marketing `name` values.
const shootingsGroup = mainLinks.find(
  (item): item is NavGroup => "subItems" in item && item.label === "Shootings"
);
const offerLabelByHref = new Map((shootingsGroup?.subItems ?? []).map(item => [item.href, item.label]));
const siblingLinks = siblings.map((sibling) => {
  const href = `/shootings/${sibling.id}/`;
  return { href, label: offerLabelByHref.get(href) ?? sibling.data.name };
});
---
<MinimalPage>
  <BaseHead title={name} description={description} slot="head">
    <SocialImage name={heroImage} />
    <SchemaOrg createData={createData} />
  </BaseHead>

  <AreaHero title={name} imageName={heroImage} description={description} eyebrow="Privates Shooting" />

  <div class="mt-12 grid gap-x-12 gap-y-12 lg:grid-cols-12">
    <article class="min-w-0 lg:col-span-7 xl:col-span-8 [&_h2]:text-left! [&_h3]:text-left!">
      <Content />
    </article>

    <AreaOfferRoute
      slug={slug}
      siblings={siblingLinks}
      class="lg:col-span-5 lg:self-start xl:col-span-4 lg:sticky lg:top-24"
    />
  </div>

  {reviewSlugs && reviewSlugs.length > 0 && (
    <AreaSection id="bewertungen" eyebrow="Erfahrungen" heading="Kundenbewertungen" class="mt-16">
      <FeaturedTestimonials slug={slug} categoryTestimonials={categoryReviews} featuredTestimonials={reviewSlugs} />
    </AreaSection>
  )}

  {images.length > 0 && (
    <AreaSection id="galerie" eyebrow="Bilder" heading="Galerie" class="mt-16">
      <Gallery sorted={images} />
    </AreaSection>
  )}

  <AreaRelatedPosts posts={relatedPosts} portfolioPrefix={portfolioPrefix} />
</MinimalPage>
