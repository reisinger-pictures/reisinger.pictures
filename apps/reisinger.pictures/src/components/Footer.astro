---
import ContactForm from "../solid/ContactForm";

interface Props {
  showContact?: boolean;
}
const { showContact = true } = Astro.props;
const today = new Date();
---
<footer>
  <div class="footer border-t bg-base-300 text-base-content border-base-300 px-4 py-8 items-center justify-center mt-10">
    <div class="items-center justify-center text-center flex flex-col gap-2">
      <div class="flex flex-wrap gap-x-4 justify-center items-center w-full">
        <a href="/impressum/" class="link link-hover">Impressum</a>
        <a href="/dsb/" class="link link-hover">Datenschutz</a>
        <a href="/tfp/" class="link link-hover">TFP</a>
        <a href="#kontakt" class="link link-hover">Kontakt</a>
      </div>
      <p class="opacity-90 text-sm mt-2">
        © 2017 - {today.getFullYear()} Florian Reisinger. Mit
        <span class="icon-[mdi--heart] text-red-600 inline-block align-middle -translate-y-px mx-1"></span>
        erstellt in Linz, Österreich.
      </p>
    </div>
  </div>
</footer>

{showContact && (
<>
  <button
    data-contact-open="fab"
    onclick="document.getElementById('contact_modal').showModal();"
    class="tooltip tooltip-left tooltip-primary btn btn-primary btn-circle fixed bottom-6 right-6 z-[90] shadow-2xl h-16 w-16 hidden sm:flex hover:scale-110 transition-transform group border-none"
    aria-label="Kontaktformular öffnen" data-tip="Lass uns unverbindlich reden!"
  >
    <span class="icon-[mdi--message-text] text-3xl group-hover:animate-pulse"></span>
  </button>

  <dialog id="contact_modal" class="modal modal-bottom sm:modal-middle z-[9999]">
    <div class="modal-box bg-base-100">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">
          <span class="icon-[mdi--close] text-xl"></span>
        </button>
      </form>
      <div class="mt-4">
        <ContactForm client:visible />
      </div>
    </div>
  </dialog>
</>
)}

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("reisinger-contact-form") as HTMLFormElement;
    const modal = document.getElementById("contact_modal") as HTMLDialogElement;
    if (!form) return;

    const nameInput = document.getElementById("form__name") as HTMLInputElement;
    const subjectInput = document.getElementById("form-subject") as HTMLInputElement;

    const updateSubject = () => {
      if (!nameInput || !subjectInput) return;
      subjectInput.value = nameInput.value.trim()
        ? "Neue Nachricht von " + nameInput.value.trim()
        : "Allgemeine Anfrage";
    };

    const fillForm = (params: URLSearchParams) => {
      for (const [key, value] of params.entries()) {
        const element = form.elements.namedItem(key);
        if (element instanceof HTMLInputElement || element instanceof HTMLTextAreaElement || element instanceof HTMLSelectElement) {
          element.value = value;
        }
      }
      updateSubject();
    };

    if (nameInput) {
      nameInput.addEventListener("input", updateSubject);
    }

    // 1. Initial aus URL-Parametern befüllen
    fillForm(new URLSearchParams(window.location.search));

    // 2. WICHTIG FÜR BROWSER-BACK:
    // Falls der Browser den Namen aus dem Cache wiederhergestellt hat,
    // setzen wir das Subject jetzt einmalig beim Page-Load passend zum aktuellen Wert.
    updateSubject();

    if (modal) {
      modal.addEventListener("close", () => {
        if (window.location.hash === "#kontakt" || window.location.search !== "") {
          history.replaceState(null, "", window.location.pathname);
        }
      });
    }

    if (window.location.hash === "#kontakt" && modal) {
      modal.showModal();
    }

    document.addEventListener("click", (e) => {
      const link = (e.target as HTMLElement)?.closest("a[href*='#kontakt']");
      if (!link) return;
      const targetUrl = new URL((link as HTMLAnchorElement).href);
      if (targetUrl.pathname === window.location.pathname) {
        e.preventDefault();
        fillForm(targetUrl.searchParams);
        history.pushState(null, "", targetUrl.href);
        if (modal && !modal.open) {
          modal.showModal();
        }
      }
    });
  });
</script>
