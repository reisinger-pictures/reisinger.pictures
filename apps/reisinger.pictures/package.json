{
  "name": "reisinger.pictures",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "build": "PUBLIC_IMAGE_CDN_URL=https://images.reisinger.pictures astro check && PUBLIC_IMAGE_CDN_URL=https://images.reisinger.pictures astro build",
    "prebuild": "node ../../packages/tools/scripts/add-metadata.mjs && node ../../packages/tools/scripts/process-images.mjs",
    "postbuild": "node ../../packages/tools/scripts/check_links.mjs && node ../../packages/tools/scripts/prune-imagedist.mjs",
    "preview": "astro preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "publish": "pnpm run test:e2e",
    "postpublish": "./sync.sh"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.0.2",
    "@tailwindcss/cli": "^4.3.3",
    "astro": "^7.3.3",
    "dayjs": "^1.11.23",
    "js-yaml": "5.4.2",
    "photoswipe": "^5.4.4",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/tailwind4": "^1.2.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.1",
    "concurrently": "^10.0.5",
    "daisyui": "^5.7.40",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
