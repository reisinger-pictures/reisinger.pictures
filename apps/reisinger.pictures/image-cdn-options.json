{
  "sources": ["src"],
  "outputDir": ".imagedist",
  "cacheDir": ".astro-image-cdn",
  "widths": [256, 640, 828, 1080, 1200, 1920, 2048],
  "formats": ["webp"],
  "quality": 75,
  "webpEffort": 4,
  "avifEffort": 4,
  "includeSourceFormat": false,
  "includeNativeWidth": false,
  "autoRotate": false,
  "verification": "stat",
  "concurrency": 4,
  "dangerouslyProcessSVG": true
}
